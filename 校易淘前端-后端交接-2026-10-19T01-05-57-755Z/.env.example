# 复制为 .env.local，修改后重启 npm run dev
DEV_PORT=5174
# 后端组员通常只需要改这一行；默认 /api 由 Vite 转发，无需浏览器跨域配置
DEV_API_TARGET=http://127.0.0.1:8080
# 以下 VITE_ 变量会进入浏览器，禁止放密码、私钥或服务端令牌
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=10000
# 监听地址：默认 127.0.0.1（仅本机）。要让局域网/公网访问改成 0.0.0.0
DEV_HOST=127.0.0.1

# Vite 会校验 Host 头；用内网穿透或域名演示时把域名加进来，否则 403
# 例：DEV_ALLOWED_HOSTS=.trycloudflare.com,localhost,127.0.0.1
DEV_ALLOWED_HOSTS=
