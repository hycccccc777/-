# =====================================================================
# 依赖与构建产物
# =====================================================================
node_modules/
dist/
target/
build/
*.jar
!**/src/**/*.jar

# =====================================================================
# 运行时产物
# =====================================================================
logs/
*.log
uploads/
tmp/
temp/

# =====================================================================
# 敏感配置
# 注意：.env.example 是模板（含占位值），必须提交，故显式不忽略
# =====================================================================
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.jks
secrets/
**/application-prod.yml
**/application-local.yml
# 例外：本项目生产 profile 模板（只引用环境变量，不含任何密钥），必须入库
!RuoYi-Vue-master/RuoYi-Vue-master/ruoyi-admin/src/main/resources/application-prod.yml

# =====================================================================
# IDE
# =====================================================================
.idea/
*.iml
*.ipr
*.iws
*.iws
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# =====================================================================
# 操作系统
# =====================================================================
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# =====================================================================
# 临时文件
# =====================================================================
*.tmp
*.temp
*.bak
*.orig
*.log.1
# 数据库备份产物（由 scripts/backup.ps1 生成，不入库）
backups/

# 本地 HTTPS 自签证书（含私钥，由 scripts/gen-cert.ps1 生成）
certs/
logs-https/
backups-offsite/
logs-lb-b/
logs-instB/
logs-noloki/
releases/
logs-a/
logs-canary*/
logs-nopass/
# 交付包：源码/数据库/部署脚本的合集，由原目录复制生成，避免重复入库
# 需要随仓库提交时删掉这一行即可
/脚本/
