<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.campus.mapper.CtCategoryMapper">

    <resultMap type="CtCategory" id="CtCategoryResult">
        <id     property="categoryId"   column="category_id"   />
        <result property="parentId"     column="parent_id"     />
        <result property="categoryName" column="category_name" />
        <result property="icon"         column="icon"          />
        <result property="orderNum"     column="order_num"     />
        <result property="status"       column="status"        />
        <result property="delFlag"      column="del_flag"      />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectCtCategoryVo">
        select category_id, parent_id, category_name, icon, order_num, status, del_flag, create_by, create_time, update_by, update_time, remark
        from ct_category
    </sql>

    <select id="selectCtCategoryList" parameterType="CtCategory" resultMap="CtCategoryResult">
        <include refid="selectCtCategoryVo"/>
        <where>
            del_flag = '0'
            <if test="parentId != null">AND parent_id = #{parentId}</if>
            <if test="categoryName != null and categoryName != ''">AND category_name like concat('%', #{categoryName}, '%')</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        order by order_num asc
    </select>

    <select id="selectCtCategoryById" parameterType="Long" resultMap="CtCategoryResult">
        <include refid="selectCtCategoryVo"/>
        where category_id = #{categoryId}
    </select>

    <insert id="insertCtCategory" parameterType="CtCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into ct_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentId != null">parent_id,</if>
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="icon != null">icon,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="parentId != null">#{parentId},</if>
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="icon != null">#{icon},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateCtCategory" parameterType="CtCategory">
        update ct_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where category_id = #{categoryId}
    </update>

    <update id="deleteCtCategoryById" parameterType="Long">
        update ct_category set del_flag = '2' where category_id = #{categoryId}
    </update>

    <update id="deleteCtCategoryByIds" parameterType="Long">
        update ct_category set del_flag = '2' where category_id in
        <foreach collection="array" item="categoryId" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </update>

</mapper>
