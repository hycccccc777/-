<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.campus.mapper.CtOrderMapper">

    <resultMap type="CtOrder" id="CtOrderResult">
        <id     property="orderId"        column="order_id"        />
        <result property="orderNo"        column="order_no"        />
        <result property="buyerId"        column="buyer_id"        />
        <result property="sellerId"       column="seller_id"       />
        <result property="groupNo"        column="group_no"        />
        <result property="totalAmount"    column="total_amount"    />
        <result property="deliveryFee"    column="delivery_fee"    />
        <result property="payAmount"      column="pay_amount"      />
        <result property="status"         column="status"          />
        <result property="deliveryType"   column="delivery_type"   />
        <result property="receiver"       column="receiver"        />
        <result property="receiverPhone"  column="receiver_phone"  />
        <result property="addressDetail"  column="address_detail"  />
        <result property="remark"         column="remark"          />
        <result property="idempotencyKey" column="idempotency_key" />
        <result property="payTime"        column="pay_time"        />
        <result property="shipTime"       column="ship_time"       />
        <result property="finishTime"     column="finish_time"     />
        <result property="cancelTime"     column="cancel_time"     />
        <result property="cancelReason"   column="cancel_reason"   />
        <result property="delFlag"        column="del_flag"        />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <collection property="orderItems" ofType="CtOrderItem" column="order_id" select="com.ruoyi.campus.mapper.CtOrderItemMapper.selectCtOrderItemByOrderId"/>
    </resultMap>

    <sql id="selectCtOrderVo">
        select order_id, order_no, buyer_id, seller_id, group_no, total_amount, delivery_fee, pay_amount, status, delivery_type, receiver, receiver_phone, address_detail, remark, idempotency_key, pay_time, ship_time, finish_time, cancel_time, cancel_reason, del_flag, create_by, create_time, update_by, update_time
        from ct_order
    </sql>

    <select id="selectCtOrderList" parameterType="CtOrder" resultMap="CtOrderResult">
        <include refid="selectCtOrderVo"/>
        <where>
            del_flag = '0'
            <if test="orderNo != null and orderNo != ''">AND order_no = #{orderNo}</if>
            <if test="buyerId != null">AND buyer_id = #{buyerId}</if>
            <if test="sellerId != null">AND seller_id = #{sellerId}</if>
            <if test="groupNo != null and groupNo != ''">AND group_no = #{groupNo}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <if test="deliveryType != null and deliveryType != ''">AND delivery_type = #{deliveryType}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectCtOrderById" parameterType="Long" resultMap="CtOrderResult">
        <include refid="selectCtOrderVo"/>
        where order_id = #{orderId}
    </select>

    <select id="selectCtOrderByOrderNo" parameterType="String" resultMap="CtOrderResult">
        <include refid="selectCtOrderVo"/>
        where order_no = #{orderNo} limit 1
    </select>

    <insert id="insertCtOrder" parameterType="CtOrder" useGeneratedKeys="true" keyProperty="orderId">
        insert into ct_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="buyerId != null">buyer_id,</if>
            <if test="sellerId != null">seller_id,</if>
            <if test="groupNo != null">group_no,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="deliveryFee != null">delivery_fee,</if>
            <if test="payAmount != null">pay_amount,</if>
            <if test="status != null">status,</if>
            <if test="deliveryType != null">delivery_type,</if>
            <if test="receiver != null">receiver,</if>
            <if test="receiverPhone != null">receiver_phone,</if>
            <if test="addressDetail != null">address_detail,</if>
            <if test="remark != null">remark,</if>
            <if test="idempotencyKey != null">idempotency_key,</if>
            <if test="createBy != null">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="buyerId != null">#{buyerId},</if>
            <if test="sellerId != null">#{sellerId},</if>
            <if test="groupNo != null">#{groupNo},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="deliveryFee != null">#{deliveryFee},</if>
            <if test="payAmount != null">#{payAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="deliveryType != null">#{deliveryType},</if>
            <if test="receiver != null">#{receiver},</if>
            <if test="receiverPhone != null">#{receiverPhone},</if>
            <if test="addressDetail != null">#{addressDetail},</if>
            <if test="remark != null">#{remark},</if>
            <if test="idempotencyKey != null">#{idempotencyKey},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateCtOrder" parameterType="CtOrder">
        update ct_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="buyerId != null">buyer_id = #{buyerId},</if>
            <if test="sellerId != null">seller_id = #{sellerId},</if>
            <if test="groupNo != null">group_no = #{groupNo},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="deliveryFee != null">delivery_fee = #{deliveryFee},</if>
            <if test="payAmount != null">pay_amount = #{payAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="deliveryType != null">delivery_type = #{deliveryType},</if>
            <if test="receiver != null">receiver = #{receiver},</if>
            <if test="receiverPhone != null">receiver_phone = #{receiverPhone},</if>
            <if test="addressDetail != null">address_detail = #{addressDetail},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="shipTime != null">ship_time = #{shipTime},</if>
            <if test="finishTime != null">finish_time = #{finishTime},</if>
            <if test="cancelTime != null">cancel_time = #{cancelTime},</if>
            <if test="cancelReason != null">cancel_reason = #{cancelReason},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where order_id = #{orderId}
    </update>

    <update id="deleteCtOrderById" parameterType="Long">
        update ct_order set del_flag = '2' where order_id = #{orderId}
    </update>

    <update id="deleteCtOrderByIds" parameterType="Long">
        update ct_order set del_flag = '2' where order_id in
        <foreach collection="array" item="orderId" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </update>

</mapper>
