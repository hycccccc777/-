<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.campus.mapper.CtOrderItemMapper">

    <resultMap type="CtOrderItem" id="CtOrderItemResult">
        <id     property="itemId"      column="item_id"      />
        <result property="orderId"     column="order_id"     />
        <result property="orderNo"     column="order_no"     />
        <result property="productId"   column="product_id"   />
        <result property="title"       column="title"        />
        <result property="coverUrl"    column="cover_url"    />
        <result property="price"       column="price"        />
        <result property="quantity"    column="quantity"     />
        <result property="totalAmount" column="total_amount" />
        <result property="createTime"  column="create_time"  />
    </resultMap>

    <sql id="selectCtOrderItemVo">
        select item_id, order_id, order_no, product_id, title, cover_url, price, quantity, total_amount, create_time
        from ct_order_item
    </sql>

    <select id="selectCtOrderItemList" parameterType="CtOrderItem" resultMap="CtOrderItemResult">
        <include refid="selectCtOrderItemVo"/>
        <where>
            <if test="orderId != null">AND order_id = #{orderId}</if>
            <if test="orderNo != null and orderNo != ''">AND order_no = #{orderNo}</if>
            <if test="productId != null">AND product_id = #{productId}</if>
        </where>
    </select>

    <select id="selectCtOrderItemById" parameterType="Long" resultMap="CtOrderItemResult">
        <include refid="selectCtOrderItemVo"/>
        where item_id = #{itemId}
    </select>

    <select id="selectCtOrderItemByOrderId" parameterType="Long" resultMap="CtOrderItemResult">
        <include refid="selectCtOrderItemVo"/>
        where order_id = #{orderId}
    </select>

    <insert id="insertCtOrderItem" parameterType="CtOrderItem" useGeneratedKeys="true" keyProperty="itemId">
        insert into ct_order_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderId != null">order_id,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="productId != null">product_id,</if>
            <if test="title != null">title,</if>
            <if test="coverUrl != null">cover_url,</if>
            <if test="price != null">price,</if>
            <if test="quantity != null">quantity,</if>
            <if test="totalAmount != null">total_amount,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderId != null">#{orderId},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="productId != null">#{productId},</if>
            <if test="title != null">#{title},</if>
            <if test="coverUrl != null">#{coverUrl},</if>
            <if test="price != null">#{price},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateCtOrderItem" parameterType="CtOrderItem">
        update ct_order_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="coverUrl != null">cover_url = #{coverUrl},</if>
            <if test="price != null">price = #{price},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
        </trim>
        where item_id = #{itemId}
    </update>

    <delete id="deleteCtOrderItemById" parameterType="Long">
        delete from ct_order_item where item_id = #{itemId}
    </delete>

    <delete id="deleteCtOrderItemByIds" parameterType="Long">
        delete from ct_order_item where item_id in
        <foreach collection="array" item="itemId" open="(" separator="," close=")">
            #{itemId}
        </foreach>
    </delete>

    <delete id="deleteCtOrderItemByOrderId" parameterType="Long">
        delete from ct_order_item where order_id = #{orderId}
    </delete>

</mapper>
