        "type": "object",
        "properties": {
          "cartItemIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "minItems": 1
          },
          "addressId": {
            "type": "integer",
            "format": "int64"
          },
          "receiver": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "pattern": "^$|^1[3-9]\\d{9}$"
          },
          "addressDetail": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "deliveryType": {
            "type": "string",
            "pattern": "^$|^[01]$"
          },
          "remark": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "idempotencyKey": {
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          }
        },
        "required": [
