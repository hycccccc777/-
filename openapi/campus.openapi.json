            "minLength": 4
          },
          "categoryId": {
            "type": "integer",
            "format": "int64"
          },
          "price": {
            "type": "number",
            "maximum": 99999,
            "minimum": 0.01
          },
          "originalPrice": {
            "type": "number",
            "maximum": 99999,
            "minimum": 0.01
          },
          "stock": {
            "type": "integer",
            "format": "int32",
            "maximum": 9999,
            "minimum": 0
          },
          "condition": {
            "type": "string",
            "pattern": "almost_new|nine|eight"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "location": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "tag": {
            "type": "string",
            "maxLength": 32,
            "minLength": 0
          },
