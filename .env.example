# =====================================================================
# docker compose 环境变量：复制为 .env 后按需修改（.env 不要提交到仓库）
# =====================================================================

# MySQL
MYSQL_ROOT_PASSWORD=<改成你自己的强口令>
MYSQL_DATABASE=shop
MYSQL_PORT=3307

# Redis
REDIS_PORT=6380

# 后端对外端口
BACKEND_PORT=8080

# 前端对外端口（保持与开发环境一致，避免改前端代码里的地址）
FRONTEND_PORT=5174

# 支付回调签名密钥：生产环境务必改成随机值，并只通过环境变量注入
CAMPUS_PAY_SECRET=<随机串，例如 openssl rand -hex 32>

# JWT 签名密钥：不设会用仓库里的开发默认值，任何人都能伪造令牌
# 生成：openssl rand -hex 48
CAMPUS_JWT_SECRET=<随机长串，至少 32 字节>

# 上传目录（挂在具名卷上，容器重建不丢图）
UPLOAD_DIR=/app/uploadPath

# =====================================================================
# 生产（上线）配置：SPRING_PROFILES_ACTIVE 设为 druid,prod 才启用生产自检与覆盖
# =====================================================================
# 生产：druid,prod；开发留空（默认 druid）
SPRING_PROFILES_ACTIVE=druid,prod

# 前端对外域名（生产必填，逗号分隔；不允许 localhost/通配符）
CAMPUS_CORS_ORIGINS=https://your-domain.com

# 支付方式：4=线下面交（默认）；接真实网关后改 1(支付宝)/2(微信)，并配置下面的回调密钥
CAMPUS_PAY_METHOD=4

# 首次上线自动把 admin 默认密码(admin123)改成该值；留空则不自动改。
# 一键部署脚本会在为空时自动生成并回填。改密码可在后台“用户管理”操作，或设 FORCE_RESET=true 重启。
CAMPUS_ADMIN_PASSWORD=
CAMPUS_ADMIN_FORCE_RESET=false

# ---- 短信验证码（腾讯云，provider=tencent 且填 secret-id 才真正发送）----
CAMPUS_SMS_ENABLED=true
CAMPUS_SMS_PROVIDER=tencent
TENCENT_SMS_SECRET_ID=<腾讯云 SecretId>
TENCENT_SMS_SECRET_KEY=<腾讯云 SecretKey>
TENCENT_SMS_SDK_APP_ID=<短信应用 SdkAppId>
TENCENT_SMS_SIGN_NAME=<短信签名>
TENCENT_SMS_TEMPLATE_ID=<模板ID，模板含一个变量 {1} 即验证码>
TENCENT_SMS_REGION=ap-guangzhou

# ---- 图片存储（腾讯云 COS；type=cos 且填 secret-id+bucket 才启用，否则本地磁盘）----
CAMPUS_STORAGE_TYPE=cos
TENCENT_COS_SECRET_ID=<腾讯云 SecretId>
TENCENT_COS_SECRET_KEY=<腾讯云 SecretKey>
TENCENT_COS_BUCKET=<bucket-1250000000>
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_PUBLIC_BASE_URL=<CDN 或桶访问域名，如 https://cdn.your-domain.com>
TENCENT_COS_KEY_PREFIX=upload